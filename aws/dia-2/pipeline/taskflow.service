# taskflow.service — la respuesta de verdad al dolor de ayer.
# Ayer, al cerrar la sesión SSH, se te moría la aplicación y lo tapamos con
# "nohup ... &". Eso es un parche. Esto es lo que hace un servidor de verdad.
#
# OJO: en un archivo de systemd los comentarios van en SU PROPIA LÍNEA. Un "# ..."
# al final de una línea con valor NO es comentario: forma parte del valor y rompe
# la unidad (User inválido, WorkingDirectory con espacios, Restart ignorado).
# Por eso cada pregunta va ARRIBA de su clave. Deja las líneas de valor limpias.

[Unit]
Description=TaskFlow API
# ¿Qué tiene que estar listo antes de arrancar una API?
After=TODO

[Service]
Type=simple
# ¿Con qué usuario corre? (el mismo con el que entras por SSH)
User=TODO
# Ojo: la base H2 se escribe en ./data, relativo a esto
WorkingDirectory=TODO
# El comando exacto, con rutas ABSOLUTAS
ExecStart=TODO

# Spring Boot sale con código 143 cuando lo para systemd. Eso NO es un fallo.
SuccessExitStatus=143

# ¿Qué quieres que pase si el proceso muere solo?
Restart=TODO
RestartSec=5

[Install]
WantedBy=multi-user.target

# Para ver la salida:  journalctl -u taskflow -f
